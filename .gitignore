# Track our code and the plugins (updated through git: see CLAUDE.md); WordPress core, uploads and config stay local.
/*
!/.gitignore
!/.lando.yml
!/README.md
!/CLAUDE.md
!/docs/
!/scripts/
!/wp-content/
/wp-content/*
!/wp-content/themes/
/wp-content/themes/*
!/wp-content/themes/nd-dive/
!/wp-content/plugins/
!/wp-content/mu-plugins/
.DS_Store
